# Optional server settings. Defaults use the bundled research models and public weather API.
HARVEST_MODEL_DIR=backend/artifacts
# Set this only for a configured weather provider endpoint.
# HARVEST_WEATHER_URL=https://api.open-meteo.com/v1/forecast
# A customer API key stays on the backend. Never put it in a VITE_ variable.
# OPEN_METEO_API_KEY=
